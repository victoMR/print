# =============================================================================
# Print — Monorepo (frontend Next.js + backend @print/api)
# Copiar a .env.local (frontend) y/o .env en raíz o packages/api/ (backend).
# Nunca commitear .env con secretos reales.
# Referencia completa: .cursorrules → Environment Variables
# =============================================================================

# --- General ---
# Entorno de ejecución (development | production | test)
NODE_ENV=development

# --- Frontend (Next.js) ---
# URL base del API backend, sin barra final. Debe coincidir con PORT del backend.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Backend — servidor ---
# URL pública del API (webhooks Printful, callbacks). En local suele ser igual que NEXT_PUBLIC_API_URL.
APP_URL=http://localhost:4000
# Puerto Express (@print/api). Debe coincidir con el host:puerto de NEXT_PUBLIC_API_URL.
PORT=4000
# Nivel de logs Pino (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# --- Printful ---
# Token privado de la tienda. Obligatorio. Obtener en developers.printful.com/tokens
PRINTFUL_TOKEN=UIzATm7ByHOfIFfQbW7ZpxmqmzPJsWdaUlbFL893
# ID de tienda. Solo si usas token a nivel cuenta (no store-level).
PRINTFUL_STORE_ID=18239821

# --- Webhooks Printful ---
# Cadena aleatoria larga; va en la ruta /webhooks/printful/{WEBHOOK_SECRET}
WEBHOOK_SECRET=

# --- Supabase (persistencia principal) ---
# URL del proyecto Supabase (Postgres + API REST gestionados).
SUPABASE_URL=https://pqnyzlvwlkwvhgpcchxm.supabase.co
# Clave service role. Solo backend; bypass RLS. Nunca exponer en Next.js ni al cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Clave anon/publica. Opcional; solo si el frontend habla directo a Supabase con RLS.
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBxbnl6bHZ3bGt3dmhncGNjaHhtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjczODczMzIsImV4cCI6MjA4Mjk2MzMzMn0.OI-k_JZwRATTI7M6LOgPn-H4wJ8jELM2UrKRN3o5QUQ

# --- Base de datos (opcional) ---
# Conexión PostgreSQL directa. Este proyecto usa Supabase (SUPABASE_* apunta al mismo Postgres).
# Útil para migraciones con psql, herramientas locales o si migras fuera de Supabase.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Banxico (tipo de cambio FIX) ---
# Token SieAPIRest para cotizar USD→MXN. Sin token, el API puede usar fallback documentado.
BANXICO_API_TOKEN=

# --- Redis (BullMQ — colas de webhooks y jobs) ---
# Local: docker compose up -d redis
REDIS_URL=redis://localhost:6379
# En dev sin Docker: REDIS_ENABLED=false (webhooks se procesan inline, sin cola)
# REDIS_ENABLED=false

# --- CFDI 4.0 / PAC (facturación México) ---
# Proveedor: facturama | sw_sapien | konfio
PAC_PROVIDER=facturama
PAC_API_KEY=
# RFC del emisor (tu negocio) para timbrar CFDI
PAC_RFC_EMISOR=

# --- Procesador de pagos (elegir uno) ---
STRIPE_SECRET_KEY=
# o
CONEKTA_PRIVATE_KEY=
