## Error Handling Pattern

```typescript
// services/printful.helper.ts
export async function callPrintful<T>(
  fn: () => Promise<{ data: { code: number; result: T } }>,
  context: { operation: string; internalId?: string },
): Promise<T> {
  try {
    const { data } = await fn();
    if (data.code !== 200) {
      throw new PrintfulError(`Unexpected code: ${data.code}`, data);
    }
    logger.info({ ...context, status: 'ok' });
    return data.result;
  } catch (err: any) {
    const status = err.response?.status;
    const printfulError = err.response?.data?.error;

    logger.error({
      ...context,
      status,
      reason: printfulError?.reason,
      message: printfulError?.message,
    });

    if (status === 401) throw new AuthError('Printful token invalid or expired');
    if (status === 429) throw new RateLimitError('Printful rate limit hit');
    if (status === 404) throw new NotFoundError(context.operation);
    if (status >= 500) throw new PrintfulServerError(printfulError?.message);

    throw err;
  }
}
```

**Rule:** every service method must use `callPrintful()`. No bare `printful.get/post` calls in services.

