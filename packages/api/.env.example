# Backend (@print/api) — copiar a packages/api/.env
# Todas las variables secretas viven aquí, no en el .env del frontend.

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
LOG_LEVEL=info
# Orígenes permitidos en CORS, separados por coma. localhost:3000 siempre incluido.
# Ejemplo prod: ALLOWED_ORIGINS=https://mrpapshop.com,https://www.mrpapshop.com
ALLOWED_ORIGINS=

# PostgreSQL — opción A (recomendada; contraseña con # $ @ *)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=mrpaps
PGPASSWORD=
PGDATABASE=mrpaps

# PostgreSQL — opción B (solo contraseña simple, sin símbolos)
# DATABASE_URL=postgres://mrpaps:password@127.0.0.1:5432/mrpaps

# Archivos subidos (diseños, previews)
UPLOAD_DIR=/var/lib/mrpaps/uploads
# Vacío o same-origin → URLs /uploads/... (Next hace proxy al API). En prod: https://mrpapshop.com
ASSETS_PUBLIC_URL=

# Auth admin y clientes — AMBAS obligatorias en producción (mín. 32 chars; openssl rand -base64 48)
# Usar claves DIFERENTES para aislar sesiones admin de sesiones cliente.
ADMIN_JWT_SECRET=
CUSTOMER_JWT_SECRET=

# Bootstrap temporal — restablecer contraseñas tras migración (openssl rand -base64 32)
# POST /api/v1/auth/bootstrap-password  →  quitar cuando ya no haga falta
ADMIN_BOOTSTRAP_SECRET=

# Printful (opcional — solo si usas sync/fulfillment Printful legacy)
# Mr. Paps (Postgres + Envia + Stripe) no requiere este token.
# PRINTFUL_TOKEN=
# PRINTFUL_STORE_ID=
# WEBHOOK_SECRET=

# Redis (cache + cola BullMQ)
# true → cache de catálogo/envíos/FX + cola webhooks Printful
# false → API arranca sin Redis (sin cache, webhooks inline)
REDIS_ENABLED=false
# Producción: incluir contraseña → redis://:TU_PASSWORD@127.0.0.1:6379
REDIS_URL=redis://localhost:6379

# TTL cache Redis (segundos)
CACHE_TTL_CATALOG_LIST_SEC=300
CACHE_TTL_CATALOG_PRODUCT_SEC=600
CACHE_TTL_FX_SEC=14400
CACHE_TTL_SHIPPING_SEC=900

# Throttle proactivo Printful (req/min, requiere Redis)
PRINTFUL_RATE_LIMIT_PER_MIN=120

# Banxico (tipo de cambio FIX)
BANXICO_API_TOKEN=

# CFDI / PAC
PAC_PROVIDER=facturama
PAC_API_KEY=
PAC_RFC_EMISOR=

# Pagos
STRIPE_SECRET_KEY=
# Signing secret del endpoint en Stripe Dashboard (whsec_...)
STRIPE_WEBHOOK_SECRET=
# URL del webhook en Stripe (HTTPS, POST, ruta exacta):
# https://tu-dominio.com/api/v1/webhooks/stripe
# Probar: curl -s https://tu-dominio.com/api/v1/webhooks/stripe  → debe responder JSON ok
CONEKTA_PRIVATE_KEY=

# Envíos (Envia.com)
ENVIA_API_TOKEN=
ENVIA_SANDBOX=true
SHIPPING_PROVIDER=envia
ENVIA_CARRIERS=estafeta,dhl,fedex,paquetexpress
SHIP_ORIGIN_ZIP=76000
SHIP_ORIGIN_CITY=Querétaro
SHIP_ORIGIN_STATE=QUE
SHIP_ORIGIN_STREET=Av. Industrial 123
SHIP_ORIGIN_PHONE=+525500000000
SHIPPING_CUSTOMER_MARKUP_PERCENT=12

# Correo transaccional (IONOS SMTP)
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Mr. Paps
# URL pública de la tienda (enlaces en correos de confirmación)
STOREFRONT_URL=http://localhost:3000

# Prueba SMTP (requiere login admin): GET /api/v1/admin/mail/status
# POST /api/v1/admin/mail/test  body: {"to":"tu@correo.com"}  o verifyOnly: true

# Seed admin (opcional, solo desarrollo)
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=
# ADMIN_SEED_NAME=Administrador
