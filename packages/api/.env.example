# Backend (@print/api) — copiar a packages/api/.env
# Todas las variables secretas viven aquí, no en el .env del frontend.

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
LOG_LEVEL=info

# PostgreSQL — opción A (recomendada; contraseña con # $ @ *)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=mrpaps
PGPASSWORD=
PGDATABASE=mrpaps

# PostgreSQL — opción B (solo contraseña simple, sin símbolos)
# DATABASE_URL=postgres://mrpaps:password@127.0.0.1:5432/mrpaps

# Archivos subidos (diseños, previews)
UPLOAD_DIR=/var/lib/mrpaps/uploads
# Vacío o same-origin → URLs /uploads/... (Next hace proxy al API). En prod: https://mrpapshop.com
ASSETS_PUBLIC_URL=

# Auth admin y clientes (mín. 32 caracteres; openssl rand -base64 48)
ADMIN_JWT_SECRET=
CUSTOMER_JWT_SECRET=

# Bootstrap temporal — restablecer contraseñas tras migración (openssl rand -base64 32)
# POST /api/v1/auth/bootstrap-password  →  quitar cuando ya no haga falta
ADMIN_BOOTSTRAP_SECRET=

# Redis (BullMQ — opcional)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Banxico (tipo de cambio FIX)
BANXICO_API_TOKEN=

# CFDI / PAC
PAC_PROVIDER=facturama
PAC_API_KEY=
PAC_RFC_EMISOR=

# Pagos
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CONEKTA_PRIVATE_KEY=

# Envíos (Envia.com)
ENVIA_API_TOKEN=
ENVIA_SANDBOX=true
SHIPPING_PROVIDER=envia
ENVIA_CARRIERS=estafeta,dhl,fedex,paquetexpress
SHIP_ORIGIN_ZIP=76000
SHIP_ORIGIN_CITY=Querétaro
SHIP_ORIGIN_STATE=QUE
SHIP_ORIGIN_STREET=Av. Industrial 123
SHIP_ORIGIN_PHONE=+525500000000
SHIPPING_CUSTOMER_MARKUP_PERCENT=12

# Correo transaccional (IONOS SMTP)
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Mr. Paps
# URL pública de la tienda (enlaces en correos de confirmación)
STOREFRONT_URL=http://localhost:3000

# Prueba SMTP (requiere login admin): GET /api/v1/admin/mail/status
# POST /api/v1/admin/mail/test  body: {"to":"tu@correo.com"}  o verifyOnly: true

# Seed admin (opcional, solo desarrollo)
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=
# ADMIN_SEED_NAME=Administrador
