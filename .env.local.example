# Frontend (Next.js) — copiar a .env.local en la raíz del monorepo.
# Solo variables NEXT_PUBLIC_* (visibles en el bundle del navegador).
# Nunca pongas tokens, DATABASE_URL ni claves secretas aquí.

NEXT_PUBLIC_API_URL=http://localhost:4000
# URL pública del storefront (sin barra final). Usada en sitemap, OG y canonical.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Solo servidor Next (webhook Stripe, etc.). En VPS: http://127.0.0.1:4000
API_INTERNAL_URL=http://127.0.0.1:4000

# Stripe — solo la clave publicable (pk_test_... / pk_live_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
