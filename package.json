{
  "name": "print",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "lighthouse": "npx lighthouse http://localhost:3000 --only-categories=performance,accessibility,best-practices,seo --chrome-flags=\"--headless\" --output=html --output-path=./lighthouse-report.html",
    "lighthouse:shop": "npx lighthouse http://localhost:3000/shop --only-categories=performance,accessibility,best-practices,seo --chrome-flags=\"--headless\" --output=html --output-path=./lighthouse-shop.html"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
